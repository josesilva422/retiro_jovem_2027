# Variáveis de ambiente (configure no Netlify: Site configuration > Environment variables).
# NUNCA coloque estes valores no código nem no GitHub.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA do Supabase: a nova (sb_secret_...) ou a antiga (service_role). NUNCA a publishable.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_cole-aqui
ADMIN_PASSWORD=uma-senha-forte-para-o-painel
# Opcional: força abrir/fechar inscrições sem editar config.json
# REGISTRATION_OPEN=true
